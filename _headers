# Cabeçalhos HTTP para o Cloudflare Pages.
# Regras mais específicas ganham às mais gerais.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'self'

# O widget TEM de poder ser embebido noutros sites: é essa a sua função.
# Por isso esta regra anula a de cima só para este ficheiro.
/embed.html
  Content-Security-Policy: frame-ancestors *
  X-Content-Type-Options: nosniff

# CSS, JavaScript e fontes têm versão no endereço (?v=9), por isso podem
# ficar em cache durante muito tempo. Ao mudar o ?v, o navegador vai buscar
# a versão nova. Lembre-se de incrementar esse número a cada alteração.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# O service worker NUNCA fica em cache. Um sw.js antigo preso no navegador é
# dos problemas mais difíceis de diagnosticar que há: fica lá durante dias e a
# pessoa continua a ver a versão velha do site sem perceber porquê.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json

# O HTML nunca fica em cache longa: é o que traz as correções aos visitantes.
/*.html
  Cache-Control: public, no-cache

/
  Cache-Control: public, no-cache
